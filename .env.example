# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV="development"

# JWT Authentication Secret
JWT_SECRET="taskflow_super_secure_jwt_secret_key_2026_x89f"

# MongoDB Database Connection String
# e.g., mongodb://localhost:27017/taskflow or MongoDB Atlas URI:
# mongodb+srv://<user>:<password>@cluster0.mongodb.net/taskflow?retryWrites=true&w=majority
# (TaskFlow automatically falls back to an embedded persistent/in-memory MongoDB store if local daemon is absent)
MONGODB_URI="mongodb://localhost:27017/taskflow"

